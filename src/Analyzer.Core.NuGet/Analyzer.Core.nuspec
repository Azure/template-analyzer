<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Azure.Templates.Analyzer.Core</id>
    <version>$version$</version>
    <authors>Microsoft</authors>
    <description>ARM and Bicep Template scanner for security misconfigurations and best practices</description>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/Azure/template-analyzer</projectUrl>
    <tags>arm bicep azure template analyzer scanner deployment security</tags>

    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Azure.Bicep.Core" version="0.37.4" />
        <dependency id="Azure.Deployments.Templates" version="1.527.0" />
        <dependency id="Newtonsoft.Json" version="13.0.4" />
        <dependency id="Microsoft.Extensions.Logging" version="10.0.15" />
        <dependency id="Microsoft.PowerPlatform.ResourceStack" version="7.0.0.2129" />
        <dependency id="Microsoft.PowerShell.SDK" version="7.6.10" />
        <dependency id="Microsoft.PSRule.Rules.Azure" version="1.35.3" />
        <dependency id="Microsoft.PSRule.SDK" version="2.9.0" />
        <dependency id="Sarif.Sdk" version="3.1.0" />
        <dependency id="System.IO.Abstractions" version="22.2.0" />
      </group>
    </dependencies>

  </metadata>

  <files>
    <file src="..\Analyzer.Core\bin\$configuration$\**" target="lib\" exclude="**\*.pdb;**\ref\**" />
    <file src="Azure.Templates.Analyzer.Core.targets" target="buildTransitive\net10.0\" />
  </files>

</package>
