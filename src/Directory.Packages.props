<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Newer Bicep drops public feature-provider members; Deployments 1.590+ needs incompatible Bicep.Types 0.6. -->
    <PackageVersion Include="Azure.Bicep.Core" Version="0.37.4" />
    <PackageVersion Include="Azure.Deployments.Core" Version="1.527.0" />
    <PackageVersion Include="Azure.Deployments.Expression" Version="1.527.0" />
    <PackageVersion Include="Azure.Deployments.Templates" Version="1.527.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.PowerPlatform.ResourceStack" Version="7.0.0.2129" />
    <!-- PowerShell 7.7 targets .NET 11. Azure Rules 1.36 deprecates rules still evaluated by the scanner. -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
    <PackageVersion Include="Microsoft.PSRule.Rules.Azure" Version="1.35.3" />
    <PackageVersion Include="Microsoft.PSRule.SDK" Version="2.9.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Sarif.Sdk" Version="3.1.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageVersion Include="System.IO.Packaging" Version="10.0.15" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
</Project>